#!/bin/sh
if [ -n "$TANGWARE_LIBRARY" ]; then
  exec uv run --quiet --project "$TANGWARE_LIBRARY/model" cad "$@"
fi
dir="$PWD"
while [ "$dir" != / ]; do
  if grep -qs tangware "$dir/model/pyproject.toml"; then
    exec uv run --quiet --project "$dir/model" cad "$@"
  fi
  dir=$(dirname "$dir")
done
exec uvx --quiet --from tangware==0.1.0 cad "$@"
