#!/usr/bin/env node
// tangware login: signs this machine in through the browser. tangware link: makes this folder of
// its repo a project, the repo's root or a design folder inside it. tangware build: prints the
// result of the build the person ran in the studio; it never starts one.
const { execFileSync } = require("node:child_process");
const { mkdirSync, writeFileSync } = require("node:fs");
const { dirname } = require("node:path");
const { studio, tokenFile, requireToken, path, repo } = require("../scripts/studio.js");

const POLL_MS = 3000;
const sleep = (ms) => new Promise((done) => setTimeout(done, ms));
const run = (cmd, args) => {
  try {
    return execFileSync(cmd, args, { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
  } catch {
    return "";
  }
};
const open = (url) => {
  console.log(`Opening ${url}`);
  run(process.platform === "darwin" ? "open" : "xdg-open", [url]);
};
const post = async (path, value, token) => {
  const response = await fetch(`${studio}${path}`, {
    method: "POST",
    headers: token ? { authorization: `Bearer ${token}` } : {},
    body: JSON.stringify(value),
  });
  return { status: response.status, body: await response.json() };
};
const fail = (message) => {
  console.error(message);
  process.exit(1);
};

async function login() {
  const { code, secret, url } = (await post("/auth/cli/start", {})).body;
  console.log(`Confirm the code ${code} in your browser.`);
  open(new URL(url, studio).href);
  for (;;) {
    await sleep(POLL_MS);
    const { status, body } = await post("/auth/cli/poll", { secret }).catch(() => ({ status: 0 }));
    if (status === 200) {
      mkdirSync(dirname(tokenFile), { recursive: true });
      writeFileSync(tokenFile, body.token, { mode: 0o600 });
      return console.log("Signed in to Tanġware.");
    }
    if (status === 410) fail("The code expired. Run tangware login again.");
  }
}

async function link() {
  const token = requireToken();
  const remote = /github\.com[:/]([^/]+)\/(.+?)(\.git)?$/.exec(run("git", ["remote", "get-url", "origin"]));
  if (!remote) fail("This repo has no GitHub remote. Push it to GitHub first.");
  const [, owner, repo] = remote;
  const ids = run("gh", ["api", `repos/${owner}/${repo}`, "--jq", "[.id, .owner.id] | @tsv"]).split("\t");
  const ask = { repo, path: path(), owner, id: Number(ids[0]) || undefined, ownerId: Number(ids[1]) || undefined };
  let opened = false;
  for (;;) {
    const { status, body } = await post("/api/projects", ask, token).catch(() => ({ status: 0 }));
    if (status === 0) {
      await sleep(POLL_MS);
      continue;
    }
    if (status === 200) return open(new URL(body.url, studio).href);
    if (status === 401) fail("Your Tanġware login was refused. Run tangware login again.");
    if (status !== 409) fail(body.error);
    if (!opened) {
      console.log(`${body.error} Waiting for you to allow it on GitHub…`);
      open(new URL(body.install, studio).href);
      opened = true;
    }
    await sleep(POLL_MS);
  }
}

const BUILD_USAGE = `usage: tangware build [<commit>] [--json]
Prints the result of the last studio build of this project, or of <commit>, and exits non-zero if it failed.
Builds start only when you press Build in the studio.`;

async function build() {
  const args = process.argv.slice(3);
  if (args.includes("--help") || args.includes("-h")) return console.log(BUILD_USAGE);
  const json = args.includes("--json");
  const [commit, extra] = args.filter((a) => a !== "--json");
  if (extra || commit?.startsWith("-")) fail(BUILD_USAGE);
  const token = requireToken();
  const name = repo();
  const url = `${studio}/api/repos/${encodeURIComponent(name)}/build-summary${commit ? `/${encodeURIComponent(commit)}` : ""}`;
  const response = await fetch(url, { headers: { authorization: `Bearer ${token}` } });
  const body = await response.json().catch(() => ({}));
  if (response.status === 401) fail("Your Tangware login was refused. Run tangware login again.");
  if (response.status !== 200) fail(body.error ?? `The studio answered ${response.status}.`);
  if (json) console.log(JSON.stringify(body, null, 2));
  else if (body.status === "none")
    console.log(`${name} at ${body.commit.sha.slice(0, 7)} has not been built. Press Build in the studio, then run tangware build again.`);
  else console.log(body.text);
  if (body.status === "failed") process.exit(1);
}

const commands = { login, link, build };
const command = commands[process.argv[2]];
if (!command) fail("usage: tangware login | tangware link | tangware build [<commit>] [--json]");
command().catch((error) => fail(String(error)));
