from build123d import Align, Axis, Box, BuildPart, Location, Locations, Select, fillet
from cad.design.parts import part
from cad.library.shapes import Printed, built

from {{package}}.master import ProductMaster

BOTTOM = (Align.CENTER, Align.CENTER, Align.MIN)


@part
def plate(m: ProductMaster) -> Printed:
    with BuildPart() as made:
        with Locations(Location(m.base)):
            Box(m.width, m.depth, m.thickness, align=BOTTOM)
        fillet(made.edges(Select.LAST).filter_by(Axis.Z), m.corner)
    return Printed(
        name="plate", pose=Location(), body=built(made), bed="-z", print_settings=m.print_settings
    )
