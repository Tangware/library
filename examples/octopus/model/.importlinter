[importlinter]
root_packages =
    octopus
    cad

[importlinter:contract:steps]
name = Assemblies read parts and the master; parts read only the master
type = layers
layers =
    octopus.assemblies
    octopus.parts
    octopus.master
    octopus.models

[importlinter:contract:parts]
name = A part never reads another part
type = independence
modules =
    octopus.parts.body
    octopus.parts.arm

[importlinter:contract:hardware]
name = Only assemblies add hardware, bought parts and mates
type = forbidden
source_modules =
    octopus.parts
forbidden_modules =
    octopus.catalogue
    cad.assembly
    cad.library.mates
    cad.library.bought.vendor
    cad.library.standard.fasteners
    cad.library.standard.magnets
    cad.library.standard.bearings
allow_indirect_imports = True
